# 教育培训Agent - 环境变量配置

# 应用配置
APP_NAME=教育培训Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=education_agent

# JWT配置（生产环境请修改为强密钥）
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===========================================
# AI模型配置（只需配置这两项）
# ===========================================

# 模型名称格式：提供商/模型名
# 支持的提供商：
#   - deepseek: deepseek/chat, deepseek/coder, deepseek/reasoner
#   - zhipu: zhipu/glm-4-flash, zhipu/glm-4
#   - openai: openai/gpt-4o-mini, openai/gpt-4o
#   - anthropic: anthropic/claude-sonnet-4-20250514, anthropic/claude-haiku-4-5-20251001
#   - qwen: qwen/qwen-turbo, qwen/qwen-plus

AI_MODEL=deepseek/chat
AI_API_KEY=your-api-key-here

# 可选：自定义API地址（留空使用默认地址）
AI_BASE_URL=

# ===========================================
# Embedding 与向量数据库配置
# ===========================================

# 默认使用本地 sentence-transformers 模型
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 如需使用 API Embedding，取消下面注释并填写
# EMBEDDING_API_KEY=your-embedding-api-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=

# 向量存储后端：chroma | qdrant
VECTOR_STORE_BACKEND=chroma
# ChromaDB 配置（留空使用本地持久化）
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# CHROMA_PERSIST_DIR=
# Qdrant 配置（local 模式无需 Docker，留空使用默认目录）
# QDRANT_PERSIST_DIR=./data/qdrant_db
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# 意图分类器配置
INTENT_CLASSIFIER_THRESHOLD=0.7
INTENT_USE_LLM=true

# ReAct 配置（启用后 Agent 会动态调用工具）
USE_REACT=false
REACT_MAX_STEPS=3
REACT_SKILLS=concept_lesson,practice_session

# ===========================================
# 飞书集成配置
# ===========================================

# 飞书 CLI 路径（默认 lark，需确保已安装）
FEISHU_CLI_PATH=lark

# 用户 open_id（ou_xxx），用于个人消息推送和日历提醒
# 在飞书开放平台或通过 CLI 获取：lark auth status
FEISHU_USER_OPEN_ID=

# 旧方式：群机器人 Webhook（可选，兼容旧配置）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# ===========================================
# 多模态 RAG 配置（阿里百炼 Qwen-VL，可选）
# ===========================================
# 总开关：是否启用多模态（图片 caption + 表格 summary）
MULTIMODAL_ENABLED=false

# VLM 提供商：openai | qwen | zhipu
VLM_PROVIDER=qwen
# 视觉模型（推荐 qwen-vl-max-latest，备选 qwen-vl-plus / qwen3-vl-32b-instruct）
VLM_MODEL=qwen-vl-max-latest
# VLM API Key（与主 AI_API_KEY 不同，需单独申请）
VLM_API_KEY=
# base URL（留空使用 provider 默认值）
VLM_BASE_URL=

# 图片 VLM 描述失败时是否阻断上传（false=降级 OCR 兜底）
MULTIMODAL_VLM_REQUIRED=false
# 是否同时跑 OCR
MULTIMODAL_USE_OCR=true
# 是否对表格元素也生成 LLM summary
MULTIMODAL_TABLE_SUMMARY_ENABLED=true

# ===========================================

# Redis配置（可选，用于缓存）
REDIS_URL=

# CORS配置（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
