# ===========================================
# 环境变量配置说明
# ===========================================
# 本项目区分开发/生产两套环境，请根据需要复制对应示例：
#
#   开发环境（本地调试）：
#     cp .env.development.example .env
#
#   生产环境（部署上线）：
#     cp .env.production.example .env
#
# 开发环境特点：
#   - SECRET_KEY 留空会自动生成（每次重启变化，仅本地用）
#   - DEBUG=true，开启调试端点
#   - 向量库默认 chroma（无需 Docker）
#
# 生产环境强制要求：
#   - SECRET_KEY 必须显式设置（>= 32 字节），否则启动失败
#   - DEBUG=false
#   - CORS 只允许实际前端域名
#   - 向量库建议 qdrant
#
# 生成强密钥：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ===========================================

ENV=development
DEBUG=true
SECRET_KEY=
AI_API_KEY=your-api-key-here
VECTOR_STORE_BACKEND=chroma
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# 管理后台超管账号（首次注册该用户名自动获得 admin 角色，留空不启用）
# 已存在用户提权请用：python promote_admin.py <username>
SUPER_ADMIN_USERNAME=

# Celery 异步任务队列（文档导入异步化）
# USE_CELERY=True 走 Celery worker（需启动：celery -A app.celery_app worker --loglevel=info --pool=solo）
# False 时降级到 BackgroundTasks 同步处理（开发环境推荐 False）
USE_CELERY=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
