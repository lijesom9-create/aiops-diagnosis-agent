# ===========================================
# 开发环境配置示例
# ===========================================
# 用法：复制本文件为 .env 即可
#   cp .env.development.example .env
#
# 开发环境特点：
#   - ENV=development，SECRET_KEY 留空会自动生成（每次重启变化，仅本地用）
#   - DEBUG=true，开启 /api/config 调试端点
#   - CORS 允许 localhost 前端
#   - 向量库推荐 qdrant（本地嵌入式，无需 Docker；也可连 Docker qdrant Server）
# ===========================================

# 运行环境（development | production）
ENV=development

# 应用配置
APP_NAME=教育培训Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=education_agent

# JWT配置（开发环境留空即可，会自动生成随机密钥）
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理后台超管账号（首次注册该用户名自动获得 admin 角色，留空不启用）
# 已存在用户提权请用：python promote_admin.py <username>
SUPER_ADMIN_USERNAME=

# 告警 webhook 共享密钥（Alertmanager → backend /api/alerts/webhook 鉴权）
# 与 alertmanager/alertmanager.yml 的 webhook_configs.http_config.authorization.credentials 一致
# 留空时 webhook 端点拒绝处理（503，secure by default，防伪造告警）
# 告警自动诊断（firing 告警 → Agent 自动诊断 → 飞书报告卡片），冷却防告警风暴
ALERT_AUTO_DIAGNOSIS_ENABLED=true
ALERT_DIAG_COOLDOWN_SECONDS=900
# 事故生命周期：重诊上限 / severity 门槛 / 抖动复用 / 恢复摘要安静期 / 服务关联窗口
DIAG_MAX_REDIAG_PER_INCIDENT=3
ALERT_MIN_SEVERITY=warning
INCIDENT_FLAPPING_WINDOW=1800
INCIDENT_RESOLVE_QUIET_PERIOD=600
INCIDENT_SERVICE_JOIN_WINDOW=1800
# 告警→服务名静态映射（JSON，告警规则无 service 标签时用）
# ==== 执行层可靠性 ====
# 诊断任务表：重试上限 / 僵尸回收窗口 / 重试退避 / worker 轮询间隔
DIAG_TASK_MAX_ATTEMPTS=3
DIAG_TASK_STALE_SECONDS=900
DIAG_TASK_RETRY_BACKOFF_SECONDS=60
DIAG_TASK_POLL_SECONDS=5
# 诊断服务组织可见性：自动诊断可读公共 + 该组织的文档（含 shared_to_diagnosis 文档）
DIAGNOSIS_ORG_ID=
# 会话 checkpoint 后端：sqlite（单机开发）/ mongodb（多副本共享，生产推荐，compose 默认已设 mongodb）
CHECKPOINT_BACKEND=sqlite

# ALERT_SERVICE_MAP={"node-exporter": "host-infra"}

ALERT_WEBHOOK_SECRET=

# Celery 异步任务队列（文档导入异步化）
# 开发环境默认 False（BackgroundTasks 同步处理，无需启动 worker）
# 若要测试异步流程：设 true + 启动 worker（celery -A app.celery_app worker --loglevel=info --pool=solo）
USE_CELERY=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI模型配置（OpenAI 兼容格式 provider/model）
AI_MODEL=deepseek-chat
AI_API_KEY=your-api-key-here
AI_BASE_URL=

# AI 容灾（可选）：主供应商鉴权/余额/持续故障时自动切换备用；不配置则关闭
# AI_FALLBACK_MODEL=zhipu/glm-4-flash
# AI_FALLBACK_API_KEY=
# AI_FALLBACK_BASE_URL=

# Embedding 配置（本地模型，代码默认 bge-small-zh-v1.5）
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量存储后端：chroma | qdrant（生产环境强制 qdrant）
VECTOR_STORE_BACKEND=qdrant

# Qdrant 嵌入式模式（本地开发，无需 Docker）
QDRANT_PERSIST_DIR=./data/qdrant_db
# Qdrant Server 模式（可选，连 Docker qdrant 或独立服务）：
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# 重排器
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# 多模态 RAG（开发环境默认关闭）
MULTIMODAL_ENABLED=false
MULTIMODAL_VECTOR_ENABLED=false

# MCP 监控工具（运维故障诊断核心，开启后 Agent 加载 query_metrics/query_logs）
# 依赖 requirements.txt 中的 langchain-mcp-adapters、mcp
MCP_ENABLED=true

# Redis（可选，留空使用内存缓存）
REDIS_URL=

# CORS（开发环境允许本地前端 + 管理后台）
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
