# ===========================================
# 开发环境配置示例
# ===========================================
# 用法：复制本文件为 .env 即可
#   cp .env.development.example .env
#
# 开发环境特点：
#   - ENV=development，SECRET_KEY 留空会自动生成（每次重启变化，仅本地用）
#   - DEBUG=true，开启 /api/config 调试端点
#   - CORS 允许 localhost 前端
#   - 向量库可用 chroma（轻量，无需 Docker）
# ===========================================

# 运行环境（development | production）
ENV=development

# 应用配置
APP_NAME=教育培训Agent
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=education_agent

# JWT配置（开发环境留空即可，会自动生成随机密钥）
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理后台超管账号（首次注册该用户名自动获得 admin 角色，留空不启用）
# 已存在用户提权请用：python promote_admin.py <username>
SUPER_ADMIN_USERNAME=

# AI模型配置
AI_MODEL=deepseek/chat
AI_API_KEY=your-api-key-here
AI_BASE_URL=

# Embedding 配置（默认本地模型）
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 向量存储后端：开发环境可用 chroma（无需 Docker）；生产环境建议 qdrant
VECTOR_STORE_BACKEND=chroma

# Qdrant 配置（local 模式）
# QDRANT_PERSIST_DIR=./data/qdrant_db

# 重排器
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# 多模态 RAG（开发环境默认关闭）
MULTIMODAL_ENABLED=false

# Redis（可选）
REDIS_URL=

# CORS（开发环境允许本地前端）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
