# ===========================================
# 生产环境配置示例
# ===========================================
# 用法：复制本文件为 .env，并填写所有 <必填> 项
#   cp .env.production.example .env
#
# 生产环境强制要求：
#   - ENV=production
#   - SECRET_KEY 必须显式设置（>= 32 字节），否则启动失败
#     生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
#   - DEBUG=false
#   - 向量存储后端必须为 qdrant（硬约束）
#   - CORS 只允许实际前端域名
#   - MongoDB 不对外暴露端口（由 docker-compose 控制）
# ===========================================

# 运行环境（development | production）
ENV=production

# 应用配置
APP_NAME=教育培训Agent
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置（容器内用服务名）
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=education_agent

# JWT配置 <必填>
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<请用上面的命令生成并填入，至少 32 字节>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 管理后台超管账号（首次注册该用户名自动获得 admin 角色，留空不启用）
# 已存在用户提权请用：python promote_admin.py <username>
SUPER_ADMIN_USERNAME=

# Celery 异步任务队列（文档导入异步化）
# 生产环境推荐 true（需单独部署 celery-worker 服务，见 docker-compose）
USE_CELERY=true
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# AI模型配置 <必填>
AI_MODEL=deepseek-chat
AI_API_KEY=<你的 AI API Key>
AI_BASE_URL=

# Embedding 配置（本地模型，代码默认 bge-small-zh-v1.5）
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# 向量存储后端：生产环境必须 qdrant（硬约束），且用 Server 模式
VECTOR_STORE_BACKEND=qdrant
# docker-compose 会注入 QDRANT_HOST=qdrant / QDRANT_PORT=6333（容器网络）
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# 本地嵌入式目录（本地调试用，Server 模式下不使用）
QDRANT_PERSIST_DIR=./data/qdrant_db

# 重排器
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# 多模态 RAG（按需开启，需配置 VLM API）
MULTIMODAL_ENABLED=false
MULTIMODAL_VECTOR_ENABLED=false

# MCP 监控工具（运维故障诊断核心）
MCP_ENABLED=true

# Redis（生产环境建议开启用于缓存 + Celery broker，由 compose 注入）
REDIS_URL=redis://redis:6379/0

# CORS <必填>：只允许实际的前端域名，多个用逗号分隔
# 不要使用通配符，不要包含 localhost
# 包含用户端和管理后台（如不同域名/端口需分别列出）
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com
