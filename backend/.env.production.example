# ===========================================
# 生产环境配置示例
# ===========================================
# 用法：复制本文件为 .env，并填写所有 <必填> 项
#   cp .env.production.example .env
#
# 生产环境强制要求：
#   - ENV=production
#   - SECRET_KEY 必须显式设置（>= 32 字节），否则启动失败
#     生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
#   - DEBUG=false
#   - CORS 只允许实际前端域名
#   - MongoDB 不对外暴露端口（由 docker-compose 控制）
# ===========================================

# 运行环境（development | production）
ENV=production

# 应用配置
APP_NAME=教育培训Agent
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 数据库配置
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=education_agent

# JWT配置 <必填>
# 生成命令：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<请用上面的命令生成并填入，至少 32 字节>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI模型配置 <必填>
AI_MODEL=deepseek/chat
AI_API_KEY=<你的 AI API Key>
AI_BASE_URL=

# Embedding 配置（默认本地模型）
USE_LOCAL_EMBEDDING=true
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 向量存储后端：生产环境建议 qdrant
VECTOR_STORE_BACKEND=qdrant
QDRANT_PERSIST_DIR=./data/qdrant_db

# 重排器
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# 多模态 RAG
MULTIMODAL_ENABLED=false

# Redis（可选，生产环境建议开启用于缓存）
REDIS_URL=

# CORS <必填>：只允许实际的前端域名，多个用逗号分隔
# 不要使用通配符，不要包含 localhost
CORS_ORIGINS=https://your-domain.com
