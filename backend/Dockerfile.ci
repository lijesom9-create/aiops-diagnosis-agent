# CI/CD 专用 Dockerfile：与本地 linux Dockerfile 差异在依赖下载源
# 本地：torch +cpu wheel 走预下载（.docker/torch）
# CI：  GitHub Actions 有公网，直接走官方源 + 清华镜像（CI 机器在海外，官方源可达）
# 用法：docker build -f backend/Dockerfile.ci -t <img> ./backend
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    git \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser appuser

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 5 --timeout 30 \
    -r requirements.txt \
    -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --trusted-host pypi.tuna.tsinghua.edu.cn \
    --extra-index-url https://download.pytorch.org/whl/cpu

COPY --chown=appuser:appuser . .

RUN mkdir -p /app/data /app/uploads && chown -R appuser:appuser /app/data /app/uploads

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=30s \
    CMD curl -f http://localhost:8000/api/health/live || exit 1

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
