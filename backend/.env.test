# ===========================================
# 测试环境配置
# ===========================================
# 用法：跑测试时加载此配置
#   APP_ENV=test python -m pytest
#
# 测试环境特点：
#   - 独立数据库 education_agent_test（不污染开发数据）
#   - 不依赖 Redis（用内存缓存，零外部服务）
#   - 禁用 LLM 调用（单元测试不需要真实 LLM）
#   - 向量库用 chroma（轻量，无需 Qdrant 服务）
# ===========================================

# 运行环境
ENV=test
APP_ENV=test

# 应用配置
APP_NAME=教育培训Agent-Test
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8001

# 数据库配置 —— 独立测试数据库，测试后自动清空
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=education_agent_test

# JWT配置（测试用固定密钥，方便断言）
SECRET_KEY=test-secret-key-for-testing-only-32bytes
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI模型配置（测试环境不调用真实 LLM）
AI_MODEL=deepseek/chat
AI_API_KEY=test-dummy-key
AI_BASE_URL=

# Embedding 配置（单元测试不加载模型，集成测试用本地模型）
USE_LOCAL_EMBEDDING=false
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 向量存储后端：测试用 chroma（无需 Docker）
VECTOR_STORE_BACKEND=chroma

# 重排器（测试环境关闭，加速）
RERANKER_ENABLED=false

# 多模态 RAG（测试环境关闭）
MULTIMODAL_ENABLED=false

# Redis（测试不用，用内存缓存）
REDIS_URL=

# CORS
CORS_ORIGINS=http://localhost:3000

# API 限流（测试环境调低，方便测试限流逻辑）
RATE_LIMIT_RPM=3
