{
  "title": "Ops Agent - 事故管理运营（降噪率 / MTTA / 路由）",
  "uid": "ops-incident-ops",
  "tags": [
    "aiops",
    "incident",
    "mtta"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "降噪压缩比（1 - 事故率/告警率）",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "description": "行业核心 KPI（调研 §2 口径）：原始告警经路由归并成事故的压缩程度。1 = 全部压缩成少量事故；接近 0 = 每条告警都变事故（降噪失效）。",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "1 - sum(rate(ops_incidents_created_total[$__rate_interval])) / clamp_min(sum(rate(ops_alerts_received_total[$__rate_interval])), 0.001)",
          "legendFormat": "compression_ratio",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "title": "原始告警接收速率（按状态）",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "description": "Alertmanager webhook 接收的原始告警数（firing/resolved）——降噪率的分子来源。",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ops_alerts_received_total[$__rate_interval])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "title": "事故创建速率",
      "type": "timeseries",
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 9,
        "h": 8
      },
      "description": "路由归并后创建的 incident 速率——降噪率的分母来源。",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ops_incidents_created_total[$__rate_interval]))",
          "legendFormat": "incidents",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "title": "路由归并级别分布（误路由探测，B1）",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "四级路由分支占比：fingerprint 命中 / flap 抖动 / join 归入（异常升高=误合并信号）/ new 新建（异常升高=服务映射失效）。",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(ops_alert_route_total[$__rate_interval])) by (level)",
          "legendFormat": "{{level}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "title": "MTTA 认领耗时（P95 / 平均）",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "description": "事故从触发到被认领的耗时（acked_at - first_seen_at）。P95 用直方图分位；平均 = sum/count。",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ops_incident_mtta_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "P95",
          "refId": "A"
        },
        {
          "expr": "sum(increase(ops_incident_mtta_seconds_sum[$__rate_interval])) / clamp_min(sum(increase(ops_incident_mtta_seconds_count[$__rate_interval])), 0.001)",
          "legendFormat": "avg",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    }
  ]
}